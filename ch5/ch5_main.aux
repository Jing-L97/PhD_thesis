\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Comparison of linguistic/conversational features across the single-turn and multi-turn testing for children. The bars show the averages across age groups. The points show variability across conversations (40 in total). Models include two LLMs (GPT-4o, Llama 3) in zero-shot and 3-shot settings. ``BB\_tuned'' which stands for the BlenderBot model fine-tuned on a subset of CHILDES. Finally, for CHILDES, the data for single-turn and multi-turn is the same.}}{69}{figure.caption.66}\protected@file@percent }
\newlabel{fig:child_multi}{{5.3}{69}{Comparison of linguistic/conversational features across the single-turn and multi-turn testing for children. The bars show the averages across age groups. The points show variability across conversations (40 in total). Models include two LLMs (GPT-4o, Llama 3) in zero-shot and 3-shot settings. ``BB\_tuned'' which stands for the BlenderBot model fine-tuned on a subset of CHILDES. Finally, for CHILDES, the data for single-turn and multi-turn is the same}{figure.caption.66}{}}
\newlabel{fig:child_multi@cref}{{[figure][3][5]5.3}{[1][69][]69}{}{}{}}
