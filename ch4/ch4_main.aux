\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Performance when retrieved sequences contain target syntactic structures (with: w/) versus when they do not (without: w/o). Top row: bounded-data model; bottom row: large-scale model ($k=16$, $\tau =3$, sequence-level). Blue and orange bars correspond to high- and low-frequency items, respectively. Within each panel, the $x$-axis shows three conditions: \textbf  {base} (no retrieval), \textbf  {w/o+r $\rightarrow $ w/o} (retrieved set does not contain structurally matched examples, random selection $\rightarrow $ embedding-similarity), and \textbf  {w/+r $\rightarrow $ w/} (retrieved set contains structurally matched examples, random selection $\rightarrow $ embedding-similarity). Solid bars denote random selection (\textbf  {+r}); hatched segments denote the additional gain from embedding-similarity ranking over random selection.}}{60}{figure.caption.61}\protected@file@percent }
\newlabel{fig:datastore}{{4.2}{60}{Performance when retrieved sequences contain target syntactic structures (with: w/) versus when they do not (without: w/o). Top row: bounded-data model; bottom row: large-scale model ($k=16$, $\tau =3$, sequence-level). Blue and orange bars correspond to high- and low-frequency items, respectively. Within each panel, the $x$-axis shows three conditions: \textbf {base} (no retrieval), \textbf {w/o+r $\rightarrow $ w/o} (retrieved set does not contain structurally matched examples, random selection $\rightarrow $ embedding-similarity), and \textbf {w/+r $\rightarrow $ w/} (retrieved set contains structurally matched examples, random selection $\rightarrow $ embedding-similarity). Solid bars denote random selection (\textbf {+r}); hatched segments denote the additional gain from embedding-similarity ranking over random selection}{figure.caption.61}{}}
\newlabel{fig:datastore@cref}{{[figure][2][4]4.2}{[1][59][]60}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Performance across retrieval granularities (token, phrase, sequence) in bounded-data (top row) and large-scale (bottom row) models ($k=16$, $\tau =3$). Blue bars indicate high-frequency items and orange bars low-frequency items. Sequence-level retrieval is numerically the overall strongest, but the effect of retrieval granularity is overall small.}}{61}{figure.caption.62}\protected@file@percent }
\newlabel{fig:granularity}{{4.3}{61}{Performance across retrieval granularities (token, phrase, sequence) in bounded-data (top row) and large-scale (bottom row) models ($k=16$, $\tau =3$). Blue bars indicate high-frequency items and orange bars low-frequency items. Sequence-level retrieval is numerically the overall strongest, but the effect of retrieval granularity is overall small}{figure.caption.62}{}}
\newlabel{fig:granularity@cref}{{[figure][3][4]4.3}{[1][60][]61}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces  Performance across context-window sizes for the bounded-data (top row) and large-scale (bottom row) settings, using sequence-level retrieval with $k=16$. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. The effects of context size are non-monotonic and phenomenon-, frequency band- and model-dependent. }}{62}{figure.caption.63}\protected@file@percent }
\newlabel{fig:context_effects}{{4.4}{62}{Performance across context-window sizes for the bounded-data (top row) and large-scale (bottom row) settings, using sequence-level retrieval with $k=16$. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. The effects of context size are non-monotonic and phenomenon-, frequency band- and model-dependent}{figure.caption.63}{}}
\newlabel{fig:context_effects@cref}{{[figure][4][4]4.4}{[1][60][]62}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces  Performance across numbers of retrieved neighbors ($k\in \{1,16,1024\}$) for the bounded-data (top row) and large-scale (bottom row) settings, using $\tau =3$ and sequence-level retrieval. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. For all six low-frequency conditions, $k=16$ outperforms both $k=1$ and $k=1024$. Effects on high-frequency items are smaller and mixed. }}{62}{figure.caption.64}\protected@file@percent }
\newlabel{fig:neighbor_effects}{{4.5}{62}{Performance across numbers of retrieved neighbors ($k\in \{1,16,1024\}$) for the bounded-data (top row) and large-scale (bottom row) settings, using $\tau =3$ and sequence-level retrieval. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. For all six low-frequency conditions, $k=16$ outperforms both $k=1$ and $k=1024$. Effects on high-frequency items are smaller and mixed}{figure.caption.64}{}}
\newlabel{fig:neighbor_effects@cref}{{[figure][5][4]4.5}{[1][61][]62}{}{}{}}
