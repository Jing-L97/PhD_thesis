\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Performance on syntactic contrasts using semantics-only retrieval strategies compared to full retrieval ($k=16$, $\tau =3$) of the bounded-data (top row) and large-scale (bottom row) models. Blue bars indicate high-frequency items and orange bars low-frequency items. }}{54}{figure.caption.54}\protected@file@percent }
\newlabel{fig:vector}{{4.1}{54}{Performance on syntactic contrasts using semantics-only retrieval strategies compared to full retrieval ($k=16$, $\tau =3$) of the bounded-data (top row) and large-scale (bottom row) models. Blue bars indicate high-frequency items and orange bars low-frequency items}{figure.caption.54}{}}
\newlabel{fig:vector@cref}{{[figure][1][4]4.1}{[1][54][]54}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.2}Effects of Retrieval Configuration}{54}{subsection.4.6.2}\protected@file@percent }
\newlabel{sec:retrieval_configuration}{{4.6.2}{54}{Effects of Retrieval Configuration}{subsection.4.6.2}{}}
\newlabel{sec:retrieval_configuration@cref}{{[subsection][2][4,6]4.6.2}{[1][54][]54}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Performance when retrieved sequences contain target syntactic structures (with: w/) versus when they do not (without: w/o). Top row: bounded-data model; bottom row: large-scale model ($k=16$, $\tau =3$, sequence-level). Blue and orange bars correspond to high- and low-frequency items, respectively. Within each panel, the $x$-axis shows three conditions: \textbf  {base} (no retrieval), \textbf  {w/o+r $\rightarrow $ w/o} (retrieved set does not contain structurally matched examples, random selection $\rightarrow $ embedding-similarity), and \textbf  {w/+r $\rightarrow $ w/} (retrieved set contains structurally matched examples, random selection $\rightarrow $ embedding-similarity). Solid bars denote random selection (\textbf  {+r}); hatched segments denote the additional gain from embedding-similarity ranking over random selection.}}{55}{figure.caption.55}\protected@file@percent }
\newlabel{fig:datastore}{{4.2}{55}{Performance when retrieved sequences contain target syntactic structures (with: w/) versus when they do not (without: w/o). Top row: bounded-data model; bottom row: large-scale model ($k=16$, $\tau =3$, sequence-level). Blue and orange bars correspond to high- and low-frequency items, respectively. Within each panel, the $x$-axis shows three conditions: \textbf {base} (no retrieval), \textbf {w/o+r $\rightarrow $ w/o} (retrieved set does not contain structurally matched examples, random selection $\rightarrow $ embedding-similarity), and \textbf {w/+r $\rightarrow $ w/} (retrieved set contains structurally matched examples, random selection $\rightarrow $ embedding-similarity). Solid bars denote random selection (\textbf {+r}); hatched segments denote the additional gain from embedding-similarity ranking over random selection}{figure.caption.55}{}}
\newlabel{fig:datastore@cref}{{[figure][2][4]4.2}{[1][54][]55}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Performance across retrieval granularities (token, phrase, sequence) in bounded-data (top row) and large-scale (bottom row) models ($k=16$, $\tau =3$). Blue bars indicate high-frequency items and orange bars low-frequency items. Sequence-level retrieval is numerically the overall strongest, but the effect of retrieval granularity is overall small.}}{56}{figure.caption.56}\protected@file@percent }
\newlabel{fig:granularity}{{4.3}{56}{Performance across retrieval granularities (token, phrase, sequence) in bounded-data (top row) and large-scale (bottom row) models ($k=16$, $\tau =3$). Blue bars indicate high-frequency items and orange bars low-frequency items. Sequence-level retrieval is numerically the overall strongest, but the effect of retrieval granularity is overall small}{figure.caption.56}{}}
\newlabel{fig:granularity@cref}{{[figure][3][4]4.3}{[1][55][]56}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces  Performance across context-window sizes for the bounded-data (top row) and large-scale (bottom row) settings, using sequence-level retrieval with $k=16$. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. The effects of context size are non-monotonic and phenomenon-, frequency band- and model-dependent. }}{57}{figure.caption.57}\protected@file@percent }
\newlabel{fig:context_effects}{{4.4}{57}{Performance across context-window sizes for the bounded-data (top row) and large-scale (bottom row) settings, using sequence-level retrieval with $k=16$. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. The effects of context size are non-monotonic and phenomenon-, frequency band- and model-dependent}{figure.caption.57}{}}
\newlabel{fig:context_effects@cref}{{[figure][4][4]4.4}{[1][55][]57}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.5}{\ignorespaces  Performance across numbers of retrieved neighbors ($k\in \{1,16,1024\}$) for the bounded-data (top row) and large-scale (bottom row) settings, using $\tau =3$ and sequence-level retrieval. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. For all six low-frequency conditions, $k=16$ outperforms both $k=1$ and $k=1024$. Effects on high-frequency items are smaller and mixed. }}{57}{figure.caption.58}\protected@file@percent }
\newlabel{fig:neighbor_effects}{{4.5}{57}{Performance across numbers of retrieved neighbors ($k\in \{1,16,1024\}$) for the bounded-data (top row) and large-scale (bottom row) settings, using $\tau =3$ and sequence-level retrieval. Blue bars indicate high-frequency items and orange bars indicate low-frequency items. For all six low-frequency conditions, $k=16$ outperforms both $k=1$ and $k=1024$. Effects on high-frequency items are smaller and mixed}{figure.caption.58}{}}
\newlabel{fig:neighbor_effects@cref}{{[figure][5][4]4.5}{[1][56][]57}{}{}{}}
