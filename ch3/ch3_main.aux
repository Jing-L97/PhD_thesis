\@writefile{lot}{\contentsline {table}{\numberline {3.4}{\ignorespaces \textbf  {Examples of generated sequences.} Samples are drawn from models trained on different datasets and architectures at a sampling temperature of 1.0. The boundary marker is replaced with blank space for readability.}}{48}{table.caption.54}\protected@file@percent }
\newlabel{tab:generation-examples}{{3.4}{48}{\textbf {Examples of generated sequences.} Samples are drawn from models trained on different datasets and architectures at a sampling temperature of 1.0. The boundary marker is replaced with blank space for readability}{table.caption.54}{}}
