\contentsline {xchapter}{Expressive vocabulary growth in children and LMs}{30}{chapter.3}%
\contentsline {table}{\numberline {3.1}{\ignorespaces \textbf {Age-appropriate scaling of training datasets across three exposure scenarios.} Estimates are derived from three exposure scenarios (100h, 500h, 1000h per year), reflecting observed variability in children’s linguistic environments \citep {cristia2019child}. Word counts assume 3 words/second; character counts assume 5.1 characters/word; utterance counts assume 10 words/utterance.}}{46}{table.caption.50}%
\contentsline {table}{\numberline {3.2}{\ignorespaces \textbf {Language model training hyperparameters.} Configurations balance model capacity, stability, and efficiency across training scales.}}{47}{table.caption.51}%
\contentsline {table}{\numberline {3.3}{\ignorespaces \textbf {Monthly progression of speech metrics.} Estimated exposure and production rates over developmental time.}}{48}{table.caption.52}%
\contentsline {table}{\numberline {3.4}{\ignorespaces \textbf {Examples of generated sequences.} Samples are drawn from models trained on different datasets and architectures at a sampling temperature of 1.0. The boundary marker is replaced with blank space for readability.}}{49}{table.caption.53}%
\addvspace {10\p@ }
\contentsline {xchapter}{Episodic memory and the lexical frequency gap}{51}{chapter.4}%
\contentsline {table}{\numberline {4.1}{\ignorespaces Syntactic contrast accuracy and perplexity (PPL) for baseline and kNN-LM models ($k=16$, $\tau =3$, sequence-level retrieval). kNN augmentation improves accuracy across all phenomena and both pretraining scales, with relative clauses showing the largest gains. Perplexity reductions are larger for the large-scale model. Bold indicates improvement over baseline.}}{57}{table.caption.57}%
\contentsline {table}{\numberline {4.2}{\ignorespaces Frequency-stratified syntactic contrast performance($k=16$, $\tau =3$; sequence-level retrieval). ER denotes error reduction, $\Delta \mathrm {acc}/(1-\mathrm {acc}_{\mathrm {base}})$. Bold indicates improvement over baseline.}}{58}{table.caption.58}%
\contentsline {table}{\numberline {4.3}{\ignorespaces Composition of child-realistic pretraining corpus combining child-directed speech, conversational dialogue, and children's books to approximate naturalistic language exposure during early childhood. CDS = child-directed speech; SWBD = Switchboard; CSTC = Children's Stories Text Corpus; OSub = OpenSubtitles.}}{66}{table.caption.64}%
\contentsline {table}{\numberline {4.4}{\ignorespaces Model architecture specifications. GPT-2 Small was trained from scratch on child-realistic data (50M words); GPT-2 XL uses the publicly released pretrained checkpoint from \citet {radford2019language} trained on WebText ($\sim $40GB).}}{67}{table.caption.65}%
\contentsline {table}{\numberline {4.5}{\ignorespaces Training hyperparameters for GPT-2 Small on the child-realistic corpus, trained for 10 epochs using a standard autoregressive language modeling objective with cross-entropy loss.}}{67}{table.caption.66}%
\contentsline {table}{\numberline {4.6}{\ignorespaces Bootstrapped $95\%$ confidence intervals on the per-frequency band accuracy delta (kNN $-$ baseline), $10{,}000$ resamples over test items ($k=16$, $\tau =3$, sequence-level).}}{69}{table.caption.67}%
\contentsline {table}{\numberline {4.7}{\ignorespaces Mixed-effects logistic regression coefficients (\texttt {correct $\sim $ Frequency * ModelType + (1$\mid $item) + (1$\mid $phenomenon)}; $k=16$, $\tau =3$, sequence-level).}}{69}{table.caption.68}%
\contentsline {table}{\numberline {4.8}{\ignorespaces Mean proportion of the 16 retrieved neighbors containing the target syntactic structure ($k=16$, $\tau =3$, sequence-level retrieval). Structural matches remain particularly sparse for relative clauses in the child-realistic setting.}}{70}{table.caption.69}%
\contentsline {table}{\numberline {4.9}{\ignorespaces $p$-values for structural-retrieval comparisons in the child-realistic and large-scale models ($k=16$, $\tau =3$, sequence-level retrieval).}}{70}{table.caption.70}%
